{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://prostodot.github.io/apps-catalog/catalog.schema.json",
  "title": "Prosto Apps Catalog",
  "type": "object",
  "required": ["schemaVersion", "name", "apps"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S" },
    "apps": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["id", "title", "description", "version", "manifest"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
            "not": { "enum": ["constructor", "prototype", "__proto__"] }
          },
          "title": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "\\S" },
          "description": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S" },
          "version": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "\\S" },
          "manifest": {
            "type": "string",
            "maxLength": 512,
            "pattern": "^(?:\\./)?(?:[a-zA-Z0-9_-][a-zA-Z0-9_.-]*/)*[a-zA-Z0-9_-][a-zA-Z0-9_.-]*\\.json(?:\\?[^\\s#]*)?$"
          }
        }
      }
    }
  }
}
